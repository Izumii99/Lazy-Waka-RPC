# WakaTime Settings
# Get your API key at: https://wakatime.com/settings/account
WAKATIME_API_KEY=your_wakatime_api_key_here

# Discord Settings
# Get your Client ID by creating an app at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here

# Bot Limits
# Set how many hours the bot should run before entering 'idle/resting' mode
DAILY_LIMIT_HOURS=3
